<!-- File: MashedPotato/MashedPotato.csproj -->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.3.0.0</Version>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>MashedPotato</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    
    <!-- Silences the .NET 10 vulnerability whinging for the Punish feed -->
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Penumbra.Api">
      <HintPath>lib\Penumbra.Api.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Luna">
      <HintPath>lib\Luna.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
